# Server-side: Wakari API origin (no trailing slash). Used by /api/checkout to sign HMAC requests.
WAKARI_API_URL=http://localhost:3333

# API key pair from the merchant dashboard (POST /api-keys). Never expose WAKARI_SECRET to the browser.
WAKARI_PUBLIC_KEY=wk_replace_me
WAKARI_SECRET=replace_me

# Optional: default checkout preferences (overridable per request)
WAKARI_CHECKOUT_CURRENCY=USD
WAKARI_CHECKOUT_CRYPTO=USDT
