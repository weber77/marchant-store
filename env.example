# Wakari API (HMAC checkout)
WAKARI_API_URL=http://localhost:3000
WAKARI_PUBLIC_KEY=
WAKARI_SECRET=
WAKARI_CHECKOUT_CURRENCY=USD
WAKARI_CHECKOUT_CRYPTO=USDT

# Inbound webhooks: register https://<your-store-domain>/api/webhooks/wakari in the merchant dashboard.
# Use the signing_secret (whsec_…) from POST /merchant-webhooks — shown once.
WAKARI_WEBHOOK_SECRET=

# SMTP — used to email customers when webhook events fire (payment.created, payment.paid, payment.expired)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: logo and footer (WakaPay-style templates)
WAKAPAY_LOGO_URL=
COMPANY_NAME=WakaPay
COMPANY_ADDRESS=
FRONTEND_URL=https://wakapay.com
# Link in emails “Back to store” (defaults to FRONTEND_URL if unset)
STORE_PUBLIC_URL=http://localhost:3000
SOCIAL_X_URL=#
SOCIAL_FACEBOOK_URL=#
SOCIAL_INSTAGRAM_URL=#
SOCIAL_LINKEDIN_URL=#
